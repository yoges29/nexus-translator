# ==============================================================================
# NEXUS Translator - Frontend Environment Configuration (Vercel / Local)
# ==============================================================================
# Public environment variables (prefixed with NEXT_PUBLIC_) are bundled at build time.
# NEVER put private API keys, database credentials, or server secrets here.

# Backend API Base URL
# - Local development: http://localhost:8000
# - Production (Render): https://your-backend-service.onrender.com (without trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Dedicated WebSocket URL for Real-Time Voice Streaming
# If omitted or left blank, the frontend automatically derives it from NEXT_PUBLIC_API_URL:
#   http://127.0.0.1:8000 -> ws://127.0.0.1:8000/api/voice/stream
#   https://backend.onrender.com -> wss://backend.onrender.com/api/voice/stream
# NEXT_PUBLIC_WS_URL=wss://your-backend-service.onrender.com
