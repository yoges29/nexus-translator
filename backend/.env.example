# ==============================================================================
# NEXUS Translator - Backend Environment Configuration (Render / Local)
# ==============================================================================

# Database Connection
# - Render PostgreSQL / Supabase / Neon: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
#   (Note: If your provider provides a URL starting with postgres://, the app will automatically normalize it)
# - Leave default or unset to automatically use local SQLite (nexus_translator.db)
DATABASE_URL=postgresql+psycopg2://nexus:nexus_secret@localhost:5432/nexus_translator

# Server Binding
# - Render automatically sets the PORT environment variable
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Configuration
# - Allowed Origins: comma-separated list of origins (no trailing slashes)
#   Example: http://localhost:3000,https://nexus-translator.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# - Allowed Origins Regex: automatically permits dynamic Vercel preview domains (*.vercel.app) and Render services (*.onrender.com)
CORS_ORIGIN_REGEX=^(https:\/\/.*\.vercel\.app|https:\/\/.*\.onrender\.com)$

# Limits & Timeouts
MAX_TEXT_LENGTH=20000
TRANSLATION_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=60

# Translation Provider (libretranslate | google)
TRANSLATION_PROVIDER=libretranslate
TRANSLATION_API_KEY=
TRANSLATION_API_URL=https://libretranslate.com

# Google Cloud Translate (only if TRANSLATION_PROVIDER=google)
GOOGLE_APPLICATION_CREDENTIALS=

# Speech-to-Text (speech_recognition | google)
STT_PROVIDER=speech_recognition
STT_API_KEY=

# Text-to-Speech (gtts | google)
TTS_PROVIDER=gtts
TTS_API_KEY=

# Upload Limits (in bytes, default: 10MB)
MAX_AUDIO_SIZE_BYTES=10485760
MAX_IMAGE_SIZE_BYTES=10485760
MAX_DOCUMENT_SIZE_BYTES=20971520
MAX_DOCUMENT_PAGES=50

# Stage 3: OCR Provider (rapidocr | tesseract | cloud_vision | mock)
OCR_PROVIDER=rapidocr
TESSERACT_CMD=
CLOUD_VISION_API_KEY=
