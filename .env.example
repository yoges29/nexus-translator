# ==============================================================================
# NEXUS Translator - Master Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local full-stack development.
# For production:
# - Set backend variables in Render Dashboard / Environment
# - Set frontend variables in Vercel Dashboard / Environment Variables

# ------------------------------------------------------------------------------
# Backend Database (PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_secret
POSTGRES_DB=nexus_translator
# If deploying to Render PostgreSQL / Supabase, supply full connection string:
DATABASE_URL=postgresql+psycopg2://nexus:nexus_secret@localhost:5432/nexus_translator

# ------------------------------------------------------------------------------
# Backend Server Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed origins (e.g. http://localhost:3000,https://nexus-translator.vercel.app)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# Regex pattern to automatically permit all Vercel preview and production deployments as well as Render services:
CORS_ORIGIN_REGEX=^(https:\/\/.*\.vercel\.app|https:\/\/.*\.onrender\.com)$

MAX_TEXT_LENGTH=20000
TRANSLATION_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------------------------
# Providers & API Keys (Private Backend Credentials)
# ------------------------------------------------------------------------------
# Translation: libretranslate | google
TRANSLATION_PROVIDER=libretranslate
TRANSLATION_API_KEY=
TRANSLATION_API_URL=https://libretranslate.com

# Google Cloud Translate (when TRANSLATION_PROVIDER=google)
GOOGLE_APPLICATION_CREDENTIALS=

# Speech-to-Text: speech_recognition | google
STT_PROVIDER=speech_recognition
STT_API_KEY=

# Text-to-Speech: gtts | google
TTS_PROVIDER=gtts
TTS_API_KEY=

# Upload size limits (bytes)
MAX_AUDIO_SIZE_BYTES=10485760
MAX_IMAGE_SIZE_BYTES=10485760
MAX_DOCUMENT_SIZE_BYTES=20971520
MAX_DOCUMENT_PAGES=50

# Stage 3: OCR (rapidocr | tesseract | cloud_vision | mock)
OCR_PROVIDER=rapidocr
TESSERACT_CMD=
CLOUD_VISION_API_KEY=

# ------------------------------------------------------------------------------
# Frontend Configuration (Public - Vercel / Client)
# ------------------------------------------------------------------------------
# Set this in Vercel to your deployed Render service URL (e.g. https://your-backend.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Dedicated WebSocket URL (auto-derived from NEXT_PUBLIC_API_URL if omitted)
# NEXT_PUBLIC_WS_URL=wss://your-backend.onrender.com
